/*
 * Sistema Integrado: Operación Aritmética + Multiplexación para 2 Displays
 * Diseñado para FPGA Cyclone IV EP4CE10E22C8.
 */

// ==========================================
// 1. MÓDULO TOP (Módulo Principal del Proyecto)
// ==========================================
module top_sistema_visualizacion (
    input  wire clk,           // Reloj de la placa (ej. 50 MHz)
    // Entradas lógicas de tu circuito
    input  wire A0, input wire A1, input wire A2, input wire A3,
    input  wire B0, input wire B1, input wire B2, input wire B3,
    input  wire nA,            // Equivale a \~A (Inversor/Control A)
    input  wire nB,            // Equivale a \~B (Inversor/Control B)
    // Salidas físicas hacia la placa de desarrollo
    output reg  [6:0] siete_seg, // Pines de segmentos compartidos {g,f,e,d,c,b,a}
    output reg  [1:0] digito_sel,// Pines de selección de display (Ánodos/Cátodos)
    output wire SG             // Salida indicadora de signo (si la necesitas en un LED)
);

    // Buses intermedios para guardar los segmentos calculados por tus módulos
    wire [6:0] seg_unidades;   // {g,f,e,d,c,b,a} del display unidades
    wire [6:0] seg_decenas;    // {g,f,e,d,c,b,a} del display decenas

    // Conectar las salidas individuales de tus decodificadores a los buses intermedios
    wire gu, fu, eu, du, cu, bu, au;
    wire gd, fd, ed, dd, cd, bd, ad;
    
    assign seg_unidades = {gu, fu, eu, du, cu, bu, au};
    assign seg_decenas  = {gd, fd, ed, dd, cd, bd, ad};

    // ------------------------------------------
    // Instancia de tu circuito original
    // ------------------------------------------
    visualizacion tu_logica_inst (
        .A0(A0), .A1(A1), .A2(A2), .A3(A3),
        .B0(B0), .B1(B1), .B2(B2), .B3(B3),
        .\~A (nA), .\~B (nB),
        // Salidas hacia las decenas
        .GD(gd), .FD(fd), .ED(ed), .DD(dd), .CD(cd), .BD(bd), .AD(ad),
        // Salidas hacia las unidades
        .GU(gu), .FU(fu), .EU(eu), .DU(du), .CU(cu), .BU(bu), .AU(au),
        .SG(SG)
    );

    // ------------------------------------------
    // Divisor de Frecuencia para Multiplexado
    // ------------------------------------------
    reg [15:0] contador = 0;
    reg clk_mux = 0;

    always @(posedge clk) begin
        // 50MHz / 25000 = 2kHz (Alterna cada ~0.5ms entre displays para evitar parpadeo)
        if (contador == 16'd25000) begin 
            contador <= 0;
            clk_mux  <= ~clk_mux;
        end else begin
            contador <= contador + 1'b1;
        end
    end

    // ------------------------------------------
    // Conmutador Dinámico de Displays (Multiplexor)
    // NOTA: Configurado para ÁNODO COMÚN (0 = Encendido, 1 = Apagado)
    // ------------------------------------------
    always @(*) begin
        if (clk_mux == 1'b0) begin
            digito_sel = 2'b10;         // Enciende el display de Unidades (Derecho)
            siete_seg  = seg_unidades;  // Envía los segmentos de las unidades
        end else begin
            digito_sel = 2'b01;         // Enciende el display de Decenas (Izquierdo)
            siete_seg  = seg_decenas;   // Envía los segmentos de las decenas
        end
    end

endmodule


// ==========================================
// 2. MÓDULOS ADJUNTOS ADAPTADOS
// ==========================================

module Semisumador (
  input X, input Y, output So, output Co
);
  assign So = (X ^ Y);
  assign Co = (X & Y);
endmodule

module Complemento2_4bits (
  input X0, input X1, input X2, input X3, input \~X ,
  output Y0, output Y1, output Y2, output Y3, output Co
);
  wire s0, s1, s2, s3, s4, s5, s6;
  assign s0 = (X0 ^ \~X );
  assign s1 = (X1 ^ \~X );
  assign s2 = (X2 ^ \~X );
  assign s3 = (X3 ^ \~X );
  Semisumador Semisumador_i0 (.X(s0), .Y(\~X ), .So(Y0), .Co(s4));
  Semisumador Semisumador_i1 (.X(s1), .Y(s4), .So(Y1), .Co(s5));
  Semisumador Semisumador_i2 (.X(s2), .Y(s5), .So(Y2), .Co(s6));
  Semisumador Semisumador_i3 (.X(s3), .Y(s6), .So(Y3), .Co(Co));
endmodule

module DIG_Add #( parameter Bits = 1 ) (
    input [(Bits-1):0] a, input [(Bits-1):0] b, input c_i,
    output [(Bits - 1):0] s, output c_o
);
   wire [Bits:0] temp;
   assign temp = a + b + c_i;
   assign s = temp [(Bits-1):0];
   assign c_o = temp[Bits];
endmodule

module Sumador_4bits (
  input A0, input A1, input A2, input A3,
  input B0, input B1, input B2, input B3, input Ci,
  output S0, output S1, output S2, output S3, output Co
);
  wire s4, s5, s6;
  DIG_Add #(.Bits(1)) DIG_Add_i0 (.a(A0), .b(B0), .c_i(Ci), .s(S0), .c_o(s4));
  DIG_Add #(.Bits(1)) DIG_Add_i1 (.a(A1), .b(B1), .c_i(s4), .s(S1), .c_o(s5));
  DIG_Add #(.Bits(1)) DIG_Add_i2 (.a(A2), .b(B2), .c_i(s5), .s(S2), .c_o(s6));
  DIG_Add #(.Bits(1)) DIG_Add_i3 (.a(A3), .b(B3), .c_i(s6), .s(S3), .c_o(Co));
endmodule

module SumRes_signo4bits (
  input A0, input A1, input A2, input A3,
  input B0, input B1, input B2, input B3,
  input \~A , input \~B , input Ci,
  output S0, output S1, output S2, output S3, output Co
);
  wire s4, s5, s6, s7, s8, s9, s10, s11;
  Complemento2_4bits Complemento2_4bits_i0 (.X0(A0), .X1(A1), .X2(A2), .X3(A3), .\~X (\~A ), .Y0(s4), .Y1(s5), .Y2(s6), .Y3(s7));
  Complemento2_4bits Complemento2_4bits_i1 (.X0(B0), .X1(B1), .X2(B2), .X3(B3), .\~X (\~B ), .Y0(s8), .Y1(s9), .Y2(s10), .Y3(s11));
  Sumador_4bits Sumador_4bits_i2 (.A0(s4), .A1(s5), .A2(s6), .A3(s7), .B0(s8), .B1(s9), .B2(s10), .B3(s11), .Ci(Ci), .S0(S0), .S1(S1), .S2(S2), .S3(S3), .Co(Co));
endmodule

module Detector_Signo (
  input A0, input A1, input A2, input A3,
  input B0, input B1, input B2, input B3,
  input \~A , input \~B ,
  output S0, output S1, output S2, output S3, output Co, output Sig
);
  wire s4, s5, s6, s7, s8, s9, s10, s11, s12;
  assign s4 = (\~A  & ~ \~B );
  assign s5 = (~ \~A  & \~B );
  SumRes_signo4bits SumRes_signo4bits_i0 (.A0(A0), .A1(A1), .A2(A2), .A3(A3), .B0(B0), .B1(B1), .B2(B2), .B3(B3), .\~A (s4), .\~B (s5), .Ci(1'b0), .S0(s6), .S1(s7), .S2(s8), .S3(s9), .Co(s10));
  assign s12 = (s4 | s5);
  assign s11 = (~ s10 & s12);
  assign Co = (s10 & ~ s12);
  Complemento2_4bits Complemento2_4bits_i1 (.X0(s6), .X1(s7), .X2(s8), .X3(s9), .\~X (s11), .Y0(S0), .Y1(S1), .Y2(S2), .Y3(S3));
  assign Sig = (s11 | (\~A  & \~B ));
endmodule

module Conversor_BIN_BCD_5bits (
  input Xc, input X3, input X2, input X1, input X0,
  output D1, output D0, output U3, output U2, output U1, output U0
);
  wire s0, s1, s2, s3;
  assign D1 = ((Xc & X2) | (Xc & X3));
  assign s0 = ~ Xc;
  assign s1 = ~ X3;
  assign s2 = ~ X2;
  assign s3 = ~ X1;
  assign D0 = ((s0 & X3 & X1) | (s0 & X3 & X2) | (Xc & s1 & s2) | (X3 & X2 & X1));
  assign U3 = ((s0 & X3 & s2 & s3) | (Xc & s1 & s2 & X1) | (Xc & X3 & X2 & s3));
  assign U2 = ((s0 & s1 & X2) | (s0 & X2 & X1) | (Xc & s2 & s3) | (Xc & X3 & s2));
  assign U1 = ((s0 & s1 & X1) | (s0 & X3 & X2 & s3) | (Xc & s1 & s2 & s3) | (Xc & X3 & s2 & X1) | (s1 & X2 & X1));
  assign U0 = X0;
endmodule

module Decodificador7seg (
  input X3, input X2, input X1, input X0,
  output g, output f, output e, output d, output c, output b, output a
);
  wire s0, s1, s2;
  assign s0 = ~ X2;
  assign s1 = ~ X1;
  assign s2 = ~ X0;
  assign g = (X3 | (s0 & X1) | (X2 & s1) | (X1 & s2));
  assign f = (X3 | (X2 & s1) | (X2 & s2) | (s1 & s2));
  assign e = ((s0 & s2) | (X1 & s2));
  assign d = (X3 | (s0 & s2) | (s0 & X1) | (X2 & s1 & X0) | (X1 & s2));
  assign c = (X2 | s1 | X0);
  assign b = (s0 | (s1 & s2) | (X1 & X0));
  assign a = (X3 | (s0 & s2) | (X2 & X0) | X1);
endmodule

module visualizacion (
  input A0, input A1, input A2, input A3,
  input B0, input B1, input B2, input B3,
  input \~A , input \~B ,
  output GD, output FD, output ED, output DD, output CD, output BD, output AD,
  output GU, output FU, output EU, output DU, output CU, output BU, output AU,
  output SG
);
  wire s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10;
  Detector_Signo Detector_Signo_i0 (.A0(A0), .A1(A1), .A2(A2), .A3(A3), .B0(B0), .B1(B1), .B2(B2), .B3(B3), .\~A (\~A ), .\~B (\~B ), .S0(s6), .S1(s7), .S2(s8), .S3(s9), .Co(s10), .Sig(SG));
  Conversor_BIN_BCD_5bits Conversor_BIN_BCD_5bits_i1 (.Xc(s10), .X3(s9), .X2(s8), .X1(s7), .X0(s6), .D1(s4), .D0(s5), .U3(s0), .U2(s1), .U1(s2), .U0(s3));
  Decodificador7seg Decodificador7seg_i2 (.X3(s0), .X2(s1), .X1(s2), .X0(s3), .g(GU), .f(FU), .e(EU), .d(DU), .c(CU), .b(BU), .a(AU));
  Decodificador7seg Decodificador7seg_i3 (.X3(1'b0), .X2(1'b0), .X1(s4), .X0(s5), .g(GD), .f(FD), .e(ED), .d(DD), .c(CD), .b(BD), .a(AD));
endmodule
